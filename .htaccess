
RewriteOptions inherit

RewriteEngine on

# Link-in-bio target: glasgowsoundbath.com/instagram
# Clean to paste into a profile, and the UTMs are added server-side, so changing
# the tagging never means editing the Instagram bio.
#  - optional trailing slash + NC: /instagram/ and /Instagram both used to 404
#  - the campaign value used to end "link-in-bio/" -- the slash sat INSIDE the
#    query string, so the campaign was literally named with a trailing slash
# NB the RewriteCond pair below must stay immediately above its RewriteRule.
RewriteCond %{HTTP_HOST} ^glasgowsoundbath\.com$ [OR]
RewriteCond %{HTTP_HOST} ^www\.glasgowsoundbath\.com$
RewriteRule ^instagram/?$ "https://www.glasgowsoundbath.com/?utm_source=instagram&utm_medium=social&utm_campaign=link-in-bio" [R=302,L,NC]

# ⚠️ Documentation and tooling are not content. CLAUDE.md was served publicly at
# /CLAUDE.md from 2026-08-24 to 2026-08-26 — it describes the hosting layout,
# the home directory, the server log paths and every internal endpoint. The FTP
# deploy SYNCS, so anything committed and not excluded lands in the web root;
# this is the second line of defence for when something slips past that list.
#
# A RewriteRule rather than <FilesMatch Require all denied> because the rewrite
# engine is already on above and this needs no Apache 2.2/2.4 syntax judgement.
# ⚠️ .json is deliberately NOT blocked — it would break any static JSON the site
# or a future manifest serves. Add names here, not extensions, if that changes.
RewriteRule \.(md|markdown|ya?ml|lock|sh|bak|orig)$ - [F,L]
